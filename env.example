# Copy this file to .env for local development with `netlify dev`.
# Never commit your real .env file.

# --- Claude API (server-side only, used by netlify/functions/claude.js) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Paystack ---
# Public key is safe to expose in the browser (VITE_ prefix = bundled into
# frontend code). Secret key must stay server-side only — no VITE_ prefix.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your-public-key
PAYSTACK_SECRET_KEY=sk_test_your-secret-key
VITE_PRO_PRICE_GHS=20

# --- Google AdSense ---
# Get these after your site is approved at https://www.google.com/adsense
# App works fine without these set — ads just won't render.
VITE_ADSENSE_CLIENT_ID=ca-pub-0000000000000000
VITE_ADSENSE_SLOT_QUIZ=0000000000
VITE_ADSENSE_SLOT_CHAT=0000000000
